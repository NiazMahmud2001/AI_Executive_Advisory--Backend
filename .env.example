# Copy to .env and fill in. `python seed.py` does this for you and writes a fresh DOC_ENCRYPTION_KEY.
# Never commit .env (it is in .gitignore).
APP_ENV=development

# Fernet key for files at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOC_ENCRYPTION_KEY=

# Demo accounts created by seed.py: test values for a local demo only. Change them before deploying anywhere.
SEED_ADMIN_NAME=Layla Mansour
SEED_ADMIN_EMAIL=admin@oasispeak.example
SEED_ADMIN_PASSWORD=AdminDemo2026!
SEED_USER_NAME=Omar Siddiqui
SEED_USER_EMAIL=employee@oasispeak.example
SEED_USER_PASSWORD=UserDemo2026!

# Sessions and cookies
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=30
COOKIE_SECURE=0
COOKIE_SAMESITE=strict
CORS_ORIGINS=

# Limits
MAX_UPLOAD_MB=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

AGENT_DELAY_MS=700
AUTOMATION_STEP_MS=600
SIMULATE_AGENT_FAILURE=0

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-31b-it:free
AGENT_TIMEOUT_SECONDS=30

